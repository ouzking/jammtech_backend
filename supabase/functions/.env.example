# Secrets des Edge Functions — copier en `supabase/functions/.env` pour le
# développement local (`supabase functions serve` le charge automatiquement).
# En staging / production : `supabase secrets set --env-file <fichier>` ou
# secrets GitHub (voir README). NE JAMAIS COMMITTER DE VRAIES VALEURS.

# --- Interne -----------------------------------------------------------------
# Secret partagé entre pg_cron (Vault `cron_secret`) et les fonctions internes.
CRON_SECRET=change-me-local-cron-secret
# Origines autorisées (CORS) — la page de suivi web.
ALLOWED_ORIGINS=*

# --- SMS ---------------------------------------------------------------------
# Ordre de bascule. Valeurs : twilio, orange, africastalking, console.
SMS_PROVIDERS=console
SMS_CONSOLE_SHOW_BODY=true
# Indicatifs autorisés pour les OTP (anti « SMS pumping »).
OTP_ALLOWED_PREFIXES=+221
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_SENDER_ADDRESS=
ORANGE_SENDER_NAME=
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
# URL publique de la fonction sms-status (accusés de livraison).
SMS_STATUS_CALLBACK_URL=
SMS_STATUS_WEBHOOK_KEY=

# --- Hook Auth « Send SMS » ----------------------------------------------------
# Généré par Supabase (Dashboard > Auth > Hooks) ou `openssl rand -base64 32`
# préfixé par v1,whsec_  — même valeur que dans supabase/.env.
SEND_SMS_HOOK_SECRETS=v1,whsec_bG9jYWwtZGV2LW9ubHktc2VuZC1zbXMtaG9vay1zZWNyZXQ=

# --- Push (Firebase Cloud Messaging) -------------------------------------------
# JSON du compte de service Firebase (brut ou encodé en base64). Vide = console.
FCM_SERVICE_ACCOUNT=

# --- Suivi SOS par lien web ----------------------------------------------------
TRACK_TOKEN_SECRET=change-me-local-track-secret
TRACK_PAGE_URL=http://127.0.0.1:8080/track/
